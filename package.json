{
  "name": "keep-together",
  "private": true,
  "packageManager": "pnpm@11.26.0",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "convex": "convex dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:instance": "scripts/dev-instance.sh",
    "qc": "node scripts/qc.mjs -- playwright test",
    "qc:pool": "node scripts/qc.mjs",
    "qc:rtt": "node scripts/qc-rtt.mjs",
    "instances:sync": "node scripts/test-instances.mjs",
    "instances:serve": "node scripts/test-instances.mjs serve",
    "qc:report": "node scripts/qc-report.mjs",
    "rehearsal:claim": "node scripts/rehearsal.mjs claim",
    "rehearsal:run": "node scripts/rehearsal.mjs run",
    "rehearsal:release": "node scripts/rehearsal.mjs release",
    "rehearsal:status": "node scripts/rehearsal.mjs status"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.96",
    "@convex-dev/migrations": "^0.3.7",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-router-devtools": "1.167.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "convex": "^1.47.0",
    "convex-helpers": "^0.1.128",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "1.63.0",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "^1.132.0",
    "@tanstack/router-plugin": "1.168.47",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "convex-test": "^0.0.62",
    "eslint": "^9.20.0",
    "happy-dom": "^21.0.3",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
